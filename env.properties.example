# Copy to ./env.properties (project root, git-ignored) for local development,
# or set these as environment variables. Environment variables win over this file.
#
# The same file starts the local services with matching settings:
#   docker compose --env-file env.properties up -d

# Database (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_DATABASE=auth
DB_USER=auth
DB_PASSWORD=auth
# Only used by docker-compose, for the MySQL root account
# DB_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT signing key: base64, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=

# Email (Gmail: use an App Password, not your account password)
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional
# SERVER_PORT=8080
# APP_BASE_URL=http://localhost:8080
# CORS_ALLOWED_ORIGINS=http://localhost:3000
