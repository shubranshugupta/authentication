# Copy to ./env.properties (project root, git-ignored) for local development,
# or set these as environment variables. Environment variables win over this file.
#
# The same file starts the local services with matching settings:
#   docker compose --env-file env.properties up -d

# Database (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_DATABASE=auth
DB_USER=auth
DB_PASSWORD=auth
# Only used by docker-compose, for the MySQL root account
# DB_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT signing key: base64, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=

# Encrypts the users' two-factor (TOTP) secrets: base64, exactly 32 bytes. Generate one with:
#   openssl rand -base64 32
# Keep it: if it changes, two-factor codes stop working for everyone who turned it on.
TOTP_ENCRYPTION_KEY=

# Optional: signing in with Google. A "Web application" OAuth client from the Google Cloud
# console, with the redirect URI http://localhost:8080/api/v1/auth/oauth2/callback/google.
# Leave both empty for no Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. In dev, emails go to Mailpit from docker-compose.yml (inbox: http://localhost:8025),
# so nothing needs setting. To send real emails instead, set the mail server here:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=          (Gmail: an App Password, not your account password)
# The sender address of every email (dev default: noreply@authcore.local; required in prod).
# With Gmail, use the Gmail address itself.
# MAIL_FROM=noreply@authcore.local
#
# Or send through the Amazon SES API instead of SMTP (see the README), with the AWS
# credentials of the environment:
# MAIL_TRANSPORT=ses
# AWS_REGION=ap-south-1
# SES_CONFIGURATION_SET=
# SES_SNS_TOPIC_ARN=        (bounces and complaints, for the suppression list)

# Optional
# Emails that get the ADMIN role (comma-separated). See "Making someone an admin" in README.md.
# AUTH_ADMIN_EMAILS=you@example.com
# SERVER_PORT=8080
# Behind a reverse proxy: use the client's address from X-Forwarded-For (see "Rate Limits" in README.md)
# FORWARD_HEADERS_STRATEGY=native
# Who issues the access tokens, and who they are for. Give each environment its own.
# JWT_ISSUER=authcore
# JWT_AUDIENCE=authcore
# Where the web app runs; emails link to it (dev default below; required in prod)
# FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Health checks and metrics (keep it inside your network; must differ from SERVER_PORT)
# MANAGEMENT_PORT=8081
# Database connections per server
# DB_POOL_SIZE=10
# When the cleanup job runs (Spring cron: second minute hour day month weekday; "-" = never)
# CLEANUP_CRON=0 7 * * * *
# The OpenAPI description and Swagger UI (on by default in dev, off in prod)
# API_DOCS_ENABLED=true
